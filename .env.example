# copy to .env and fill in. never commit .env.

# local llm (any openai-compatible server; defaults suit ollama on this machine)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# made from qwen3.5:4b by ollama\Modelfile (README step 3), with the 32k context built in
LLM_MODEL=kb4-analyst
# qwen's "precise" thinking-mode sampling (model card); a high presence penalty can make it mix in chinese.
# leave a value empty to use the model's own default
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.95
LLM_PRESENCE_PENALTY=0
# empty keeps thinking on; "none" turns it off (faster, but the small model then skips tool calls)
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=8192
LLM_MAX_TOOL_LOOPS=8
LLM_MAX_TOOL_CHARS=12000
LLM_TIMEOUT_SECONDS=180
# show knowbe4_raw_get to the chat model (it stays available to other mcp clients)
LLM_EXPOSE_RAW_GET=false
# show raw user lists and full risk histories to the chat model (the summary tools cover them)
LLM_EXPOSE_RAW_LISTS=false
# earlier messages sent with each question, so follow-ups like "2" or "show more" work
LLM_HISTORY_MESSAGES=6

# mcp server and web chat (keep on 127.0.0.1)
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

WEB_HOST=127.0.0.1
WEB_PORT=8080
# extra host names the web chat answers to, comma-separated (127.0.0.1 and localhost always work)
WEB_ALLOWED_HOSTS=
# another consoles file instead of config/consoles.yaml (optional)
KB4_CONSOLES_FILE=

# knowbe4 reporting api keys, one per console in config/consoles.yaml
# (variable names must match each console's api_key_env)
KB4_MAIN_API_KEY=your-reporting-api-key
KB4_SUBSIDIARY_API_KEY=your-reporting-api-key
# optional product api keys (KnowBe4 Account Settings > API); name them in consoles.yaml (ksat_key_env and so on).
# prefer read-only scopes. the bot only ever reads, whatever the key allows.
# KB4_MAIN_KSAT_KEY=your-ksat-product-api-key
# KB4_MAIN_PHISHER_KEY=your-phisher-product-api-key
# KB4_MAIN_PIQ_KEY=your-passwordiq-product-api-key
# KB4_MAIN_COACH_KEY=your-real-time-coaching-product-api-key
# KB4_MAIN_EVENTS_KEY=your-user-event-api-key

# request behaviour
KB4_TIMEOUT_SECONDS=30
# retries after the first try (network errors, 429, 502-504)
KB4_MAX_RETRIES=4
KB4_PER_PAGE=500
KB4_MAX_RECORDS_PER_TOOL=5000
# about 48 requests a minute, under the reported 50/min burst limit
KB4_RATE_LIMIT_RPS=0.8
# reuse KnowBe4 answers for this many seconds (0 = always fetch fresh)
KB4_CACHE_SECONDS=600
# where the rolling 24 h request count is kept; empty = .kb4_usage.json in the project folder
KB4_USAGE_FILE=
# requests per console per rolling 24 h; leave empty for KnowBe4's limit (2,000 + licensed seats)
KB4_DAILY_LIMIT=

# optional
ENABLE_RAW_GET=true
