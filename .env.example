# copy to .env and fill in. never commit .env.

# gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# mcp server and web chat (keep on 127.0.0.1)
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

WEB_HOST=127.0.0.1
WEB_PORT=8080

# knowbe4 reporting api keys, one per console in config/consoles.yaml
# (variable names must match each console's api_key_env)
KB4_MAIN_API_KEY=your-reporting-api-key
KB4_SUBSIDIARY_API_KEY=your-reporting-api-key

# request behaviour
KB4_TIMEOUT_SECONDS=30
KB4_MAX_RETRIES=4
KB4_PER_PAGE=500
KB4_MAX_RECORDS_PER_TOOL=5000
KB4_RATE_LIMIT_RPS=8

# optional
ENABLE_RAW_GET=true
